{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="card shadow mb-4 form-xs">
	<div class="card-header py-3">
      	<h6 class="m-0 font-weight-bold text-primary text-center">Inscription</h6>
	</div>
	<div class="card-body">
		{{ form_start(form)}}
		{{ form_row(form.username,{'label':'Nom d\'utilisateur'})}}
		{{ form_row(form.email)}}
		{{ form_row(form.password,{'label':'Mot de passe'})}}
		{{ form_row(form.confirm_password,{'label':'Confirmer votre mot de passe'})}}
		 <button class="btn btn-primary" type="submit">S'enregistrer</button>
		{{form_end(form)}}
	</div>
</div>
{% endblock %}