{% extends 'base.html.twig' %}

{% block title %} Ernest Thinon site portfolio {% endblock %}

{% block stylesheets %}
<link href="{{asset('asset/css/maya/site/acceuil.css')}}" rel="stylesheet">
{% endblock %}



{% block body %}
<div class="brand">
	<img src="{{asset('asset/img/5_1.jpg.webp')}}" alt='oeuvre de fond'>
	<div class="text">
		<h1 class="title">Ernest THINON</h1>
		<a href="{{path('collection',{id:randomCollection.id})}}" class="random"><i class="fas fa-random"></i>Voir une collection</a>
	</div>
	<a href="{{path('puzzle')}}" class="random"><i class="fas fa-puzzle-piece"></i> Puzzle</a>
</div>
<div class="container-lg">
	<!-- Lettre -->
	{% if acceuil.image is not null %}
		<div class="img_presentation"><img src="{{acceuil.image| imagine_filter('carre')}}" width="250" height="250" alt="lettre point contemporain"></div>
	{% endif %}
	{% if acceuil.texte is not null %}
	<div class="texte_presentation"> {{acceuil.texte|raw}}</div>
	{% endif %}
	<div class="clear"></div>
</div>


{% endblock %}
