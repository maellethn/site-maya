{% extends 'base.html.twig' %}

{% block title %} Maya Thinon site portfolio {% endblock %}

{% block stylesheets %}
<link href="{{asset('asset/css/maya/site/acceuil.css')}}" rel="stylesheet">
{% endblock %}



{% block body %}
<div class="brand">
	<img src="{{asset('asset/img/5_1.jpg.webp')}}" alt='oeuvre de fond'>
	<div class="text">
		<h1 class="title">Maya THINON</h1>
		<a href="{{path('collection',{id:randomCollection.id})}}" class="random"><i class="fas fa-random"></i>Voir une collection</a>
	</div>
</div>
<div class="container-lg">
	<!-- Lettre -->
	{% if acceuil.image %}
		<div class="img_presentation"><img src="{{asset(acceuil.image)|imagine_filter('carre')}}" alt="lettre point contemporain"></div>
	{% endif %}
	{% if acceuil.texte %}
	<div class="texte_presentation"> {{acceuil.texte|raw}}</div>
	{% endif %}
	<img src="{{asset('asset/img/lettre.jpg.webp')}}" alt="lettre point contemporain" class="lettre">
</div>

{% endblock %}
