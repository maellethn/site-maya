{% extends 'base.html.twig' %}

{% block title %} Maya Thinon {{collection.Titre}} {% endblock %}

{% block body %}
	<div class="banniere" style="background-color: {{collection.Couleur.hexa}};">
		<h1 class="title"> {{collection.Titre}} </h1>
	</div>
	<div class="container-lg">
	{% if slider is not empty %}
		<div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
		  <div class="carousel-inner">
		  <div class="carousel-item active">
			      <img src="{{asset(slider[0].Lien)}}" class="d-block w-100" alt="{{collection.Oeuvre[0].Description}}">
			    </div>
		  	{% for oeuvre in slider[1:] %}
			    <div class="carousel-item">
			      <img src="{{asset(oeuvre.Lien)}}" class="d-block w-100" alt="{{oeuvre.Description}}">
			    </div>
			{% endfor %}
		  </div>
		  <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-bs-slide="prev">
		    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
		    <span class="visually-hidden">Previous</span>
		  </a>
		  <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-bs-slide="next">
		    <span class="carousel-control-next-icon" aria-hidden="true"></span>
		    <span class="visually-hidden">Next</span>
		  </a>
		</div>
	{% endif %}
		<div class="row row-cols-1 row-cols-md-3 g-4" data-masonry='{"percentPosition" : true}'>
		{% for oeuvre in collection.Oeuvre %}
			<div class="col">
		    <div class="card">
		    <a href="{{asset(oeuvre.Lien)}}">
					<img src="{{asset(oeuvre.Lien|imagine_filter('carre'))}}" class="card-img-top" alt="{{oeuvre.Description}}">

	      	</a>
		      <div class="card-body">
		        <h5 class="card-title">{{oeuvre.Titre}}</h5>
		        <p class="card-text">{{oeuvre.Description}}</p>
		      </div>
		    </div>
		  </div>
		{% endfor %}
		</div>
	</div>
{% endblock %}
