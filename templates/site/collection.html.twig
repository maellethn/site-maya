{% extends 'base.html.twig' %}

{% block stylesheets %}
	<link href="{{asset('asset/css/nivo-lightbox.css')}}" rel="stylesheet" type="text/css">
	<link href="{{asset('asset/css/themes/default/default.css')}}" rel="stylesheet" type="text/css">
{% endblock %}

{% block title %}
	Maya Thinon
	{{collection.Titre}}
{% endblock %}

{% block body %}
	<div class="banniere" style="background-color: {{collection.Couleur ? collection.Couleur.hexa : 'white' }};">
		<h1 class="title">
			{{collection.Titre}}
		</h1>
	</div>
	<div class="container-lg collection">
		{% if slider is not empty %}
			<div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
				<div class="carousel-inner">
					<div class="carousel-item active">
						<img src="{{asset(slider[0].Lien)}}" class="d-block w-100" alt="{{collection.Oeuvre[0].Description}}">
					</div>
					{% for oeuvre in slider[1:] %}
						<div class="carousel-item">
							<img src="{{asset(oeuvre.Lien)}}" class="d-block w-100" alt="{{oeuvre.Description}}">
						</div>
					{% endfor %}
				</div>
				<a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-bs-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</a>
				<a class="carousel-control-next" href="#carouselExampleControls" role="button" data-bs-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</a>
			</div>
		{% endif %}
		<div class="grid" id="gallery" data-toggle="modal" data-target="#exampleModal">

			{% for oeuvre in collection.Oeuvre %}
				<div class="card">
					{% if oeuvre.lien|slice(-3) == 'pdf' %}
						<img src="{{asset('asset/img/pdf-icon.png')}}" class="card-img-top" alt="{{oeuvre.Description}}">
					{% else %}
						{% set link = asset(oeuvre.Lien)|slice(-5) == '.webp' ? asset(oeuvre.Lien)|replace({'.webp': '',}) : asset(oeuvre.Lien) %}
						<a href="{{link}}" title="{{oeuvre.Titre}}" data-lightbox-gallery="gallery1">
							<img src="{{asset(oeuvre.Lien|imagine_filter('collection'))}}" class="card-img-top" alt="{{oeuvre.Description}}">
						</a>

					{% endif %}
					<div class="card-body">
						<h5 class="card-title">{{oeuvre.Titre}}</h5>
						<p class="card-text">{{oeuvre.Description}}</p>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endblock %}
{% block javascripts %}
	<script src="{{asset('asset/js/categorie.js')}}"></script>
	<script src="{{asset('asset/js/nivo-lightbox.js')}}"></script>
	<script>
		$(document).ready(function(){
			$('a').nivoLightbox({
				effect:'fade',
			});
		});
	</script>

{% endblock %}
