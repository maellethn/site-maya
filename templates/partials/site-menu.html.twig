{% set currentPath = app.request.attributes.get('_route') %}

<nav class="main-menu {{ currentPath == 'site' ? 'transparency' : '' }}" role="navigation">
    <ul>
        <li>
            <a href="{{ path('site') }}">Acceuil</a>
        </li>
        <li class="parent-link">
            <span>Projets</span>
            {% if categories is defined %}
                <ul class="sub-menu">
                    {% for categorie in categories %}
                        <li>
                            <a href="{{ path('collection',{id:categorie.id}) }}">{{ categorie.Titre }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </li>
        {% if expositions is defined and expositions|length > 0 %}
            <li>
                <a href="{{ path('exposition_list') }}"><span>Expositions</span></a>
            </li>
        {% endif %}
    </ul>
</nav>
