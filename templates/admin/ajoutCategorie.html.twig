{% extends 'base.html.twig' %}
{% block stylesheets %}{% include 'admin/adminStylesheet.html.twig' %}{% endblock %}
{% block title %}Nouvelle Catégorie{% endblock %}

{% block body %}
  {% include 'admin/adminNav.html.twig' %}
  <div class="container-lg">
    <div class="card shadow mb-4 form-xs">
      <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary text-center">
            {% if categorie is defined%}
              Modifier la
            {% else %}
              Ajouter une
            {% endif %}
            catégorie</h6>
      </div>
      <div class="card-body">
        {{ form_start(form)}}
        {{ form_row(form.Titre,{'label':'Titre'})}}
        {{ form_row(form.Couleur,{'label':'Couleur'})}}
        {{ form_row(form.public,{'label':'Public'})}}
      <button class="btn btn-primary" type="submit">{% if categorie  is defined%}

              Modifier
            {% else %}
              Ajouter
            {% endif %}</button>
        {{form_end(form)}}
      </div>
    </div>
  </div>

{% endblock %}
{% block javascripts %}{% include 'admin/adminJavascript.html.twig' %}{% endblock %}
