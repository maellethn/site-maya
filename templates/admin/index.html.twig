{% extends 'base.html.twig' %}
{% block stylesheets %}{% include 'admin/adminStylesheet.html.twig' %}{% endblock %}
{% block title %}Administration{% endblock %}

{% block body %}
{% include 'admin/adminNav.html.twig' %}

<div class="example-wrapper">
    <h1>Le texte de présentation :</h1>
    <div class="text_acceuil">
        {{acceuil.texte}}
    </div>
    <h1> L'image associée :</h1>
<img src="{{asset(acceuil.image)}}" alt="image de présentation">
<div class="card-body">
	{{ form_start(form)}}
	{{ form_row(form.texte,{'label':'Titre'}) }}
	{{ form_row(form.image,{'label':'Description'})}}
	<button class="btn btn-primary" type="submit">Modifier</button>
	{{form_end(form)}}
</div>



</div>
{% endblock %}
{% block javascripts %}{% include 'admin/adminJavascript.html.twig' %}{% endblock %}
