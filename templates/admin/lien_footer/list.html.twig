{% extends 'base.html.twig' %}
{% block title %}Admin | Lien footer{% endblock %}
{% block stylesheets %}
    <link href="{{ asset('asset/css/admin/global.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'admin/adminNav.html.twig' %}
    <div class="container-lg">
        <div class="action-links">
            <a href="{{ path('admin_lien_footer_add') }}" class="btn btn-primary">Ajouter un lien <i class="fa-solid fa-plus"></i></a>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered" id="liens-footer-datatable" width="100%" cellspacing="0">
                <thead class="thead-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Label</th>
                    <th scope="col">Lien</th>
                    <th scope="col">Icone</th>
                    <th scope="col">Suppression</th>
                    <th scope="col">Modification</th>
                </tr>
                </thead>
                <tbody>
                {% for lien in liens %}
                <tr>
                    <th scope="row">{{ lien.id }}</th>
                    <td>{{ lien.label }}</td>
                    <td>{{ lien.lien }}</td>
                    <td>{{ lien.icone }}</td>
                    <td>
                        <a href="{{ path('admin_lien_footer_suppression',{id:lien.id}) }}">
                            <svg class="bi bi-trash-fill" width="1em" height="1em" viewbox="0 0 16 16"
                                 fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd"
                                      d="M2.5 1a1 1 0 00-1 1v1a1 1 0 001 1H3v9a2 2 0 002 2h6a2 2 0 002-2V4h.5a1 1 0 001-1V2a1 1 0 00-1-1H10a1 1 0 00-1-1H7a1 1 0 00-1 1H2.5zm3 4a.5.5 0 01.5.5v7a.5.5 0 01-1 0v-7a.5.5 0 01.5-.5zM8 5a.5.5 0 01.5.5v7a.5.5 0 01-1 0v-7A.5.5 0 018 5zm3 .5a.5.5 0 00-1 0v7a.5.5 0 001 0v-7z"
                                      clip-rule="evenodd"/>
                            </svg>
                        </a>
                    </td>
                    <td>
                        <a href="{{ path('admin_lien_footer_edit',{id:lien.id}) }}">
                            <svg class="bi bi-brush" width="1em" height="1em" viewbox="0 0 16 16" fill="currentColor"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M15.213 1.018a.572.572 0 01.756.05.57.57 0 01.057.746C15.085 3.082 12.044 7.107 9.6 9.55c-.71.71-1.42 1.243-1.952 1.596-.508.339-1.167.234-1.599-.197-.416-.416-.53-1.047-.212-1.543.346-.542.887-1.273 1.642-1.977 2.521-2.35 6.476-5.44 7.734-6.411z"/>
                                <path d="M7 12a2 2 0 01-2 2c-1 0-2 0-3.5-.5s.5-1 1-1.5 1.395-2 2.5-2a2 2 0 012 2z"/>
                            </svg>
                        </a>
                    </td>
                    {% endfor %}
                </tbody>
                <tfoot class="thead-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Label</th>
                    <th scope="col">Lien</th>
                    <th scope="col">Icone</th>
                    <th scope="col">Suppression</th>
                    <th scope="col">Modification</th>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>

{% endblock %}
{% block javascripts %}
    {% include 'admin/adminJavascript.html.twig' %}
    <script>
        $(document).ready(function () {
            $('#liens-footer-datatable').DataTable();
        });
    </script>
{% endblock %}

