<!DOCTYPE html>
<html lang='fr'>
    <head>
        <meta charset="UTF-8">
        <meta name="description" content="Ernest THINON, étudiant des Beaux-Arts, vous propose un bric à brac séduisant de couleur, texture et signes." />
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="google-site-verification" content="dyR5v1QxRN98UFM0bF8oPU_4AFydXHPmkCZdcRqZGpI" />
        <title>{% block title %}Ernest Thinon site portfolio{% endblock %}</title>
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
        <link rel="preconnect" href="https://fonts.gstatic.com">
        <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&display=swap" rel="stylesheet">
	      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-giJF6kkoqNQ00vy+HMDP7azOuL0xtbfIcaT9wjKHr8RbDVddVHyTfAAsrekwKmP1" crossorigin="anonymous">
		    <link href="{{asset('asset/css/monCss.css')}}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
    <header>
    {% set currentPath = path(app.request.attributes.get('_route'),
                       app.request.attributes.get('_route_params')) %}
    {% if categories is defined and currentPath!="/admin/categories" %}
        <div class="collapse" id="navbarToggleExternalContent">
          <div class="p-4">
            {%  for categorie in categories %}
              <a href="{{path('collection',{id:categorie.id})}}"><h2 class="h4">{{categorie.Titre}}</h5></a>
            {% endfor %}
            <a href="{{path('site')}}">
              <h2 class="h4">Acceuil</h2>
            </a>

          </div>
        </div>
        <nav class="navbar">
          <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
              <i class="fas fa-bars"></i>
            </button>
          </div>
        </nav>
    {% endif %}
    </header>
    <div class="container-fluid">
        {% block body %}{% endblock %}
	  </div>
    <footer>
      <div class="container-lg">
        <div class="socials">
          <a class="insta" href="https://www.instagram.com/ernest_thinon/"><i class="fab fa-instagram"></i><span>Instagram</span></a>
          <a class="monochrome" href="http://journalmonochrome.fr/"><i class="fas fa-book-open"></i><span>Journal monochrome</span></a>
          <a class="point" href="http://pointcontemporain.com/tag/maya-thinon/"><i class="fas fa-pen-fancy"></i><span>Point contemporain</span></a>
        </div>
        <div class="contact">
          <a class="mail" href="mailto:ernest.thinon@gmail.com"><i class="far fa-envelope"></i>ernest.thinon@gmail.com</a>
        </div>
      </div>
    </footer>
    <script src="https://kit.fontawesome.com/b06436898d.js" crossorigin="anonymous"></script>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.10.2/jquery.min.js"></script>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js" integrity="sha384-ygbV9kiqUc6oa4msXn9868pTtWMgiQaeYH7/t7LECLbyPA2x65Kgf80OJFdroafW" crossorigin="anonymous"></script>

    <script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>

    <script src="https://unpkg.com/imagesloaded@4/imagesloaded.pkgd.min.js"></script>

		  <!-- Core plugin JavaScript-->

    {% block javascripts %}{% endblock %}
    </body>

</html>
